---
import { Icon } from 'astro-icon/components';
import LayoutBase from '../layouts/LayoutBase.astro';
import CamposProteccion from '../components/CamposProteccion.astro';
import { conBase } from '../lib/rutas';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { citaPresidente } from '../data/institucion';
import { contacto, telefonoEnlace, accionFormulario, redesSociales } from '../data/contacto';

const datos = [
  { etiqueta: 'Sede', valor: contacto.direccion ? `${contacto.direccion}, ${contacto.ciudad}` : contacto.ciudad },
  ...redesSociales.map(({ nombre, href }) => ({ etiqueta: nombre, valor: href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href })),
  { etiqueta: 'Email', valor: contacto.email, href: `mailto:${contacto.email}` },
  { etiqueta: 'Teléfono', valor: contacto.telefono, href: `tel:${telefonoEnlace}` },
];

const campo =
  'mt-1 block min-h-11 w-full rounded border border-gray-300 bg-white px-3 py-2 text-base text-gray-900 ' +
  'placeholder:text-gray-400 focus:border-py-azul focus:outline-2 focus:outline-offset-0 focus:outline-py-azul';
const etiquetaCampo = 'text-sm font-semibold text-gray-800';
---

<LayoutBase
  titulo="Contacto"
  descripcion="Contactá al Instituto de Profesionales Paraguayos del Sector Eléctrico (IPPSE): consultas, prensa e instituciones."
>
  <EncabezadoPagina titulo="Contacto" />

  <div class="mx-auto grid grid-cols-1 max-w-7xl gap-10 px-4 py-10 sm:px-6 md:py-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-8">
    <!-- Cita y datos de contacto -->
    <div>
      <figure>
        <blockquote class="font-serif text-xl font-semibold leading-snug text-gray-900 sm:text-2xl">
          <p>“{citaPresidente.texto}”</p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-gray-600">— {citaPresidente.autor}</figcaption>
      </figure>

      <dl class="mt-10 divide-y divide-gray-200 border-y border-gray-200">
        {datos.map(({ etiqueta, valor, href }) => (
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
            <dt class="font-serif text-sm font-semibold text-gray-500">{etiqueta}</dt>
            <dd class="font-medium text-gray-900">{href ? <a href={href} class="inline-flex min-h-11 items-center">{valor}</a> : valor}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Formulario -->
    <section id="formulario" aria-labelledby="formulario-titulo" class="rounded border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
      <h2 id="formulario-titulo" class="sr-only">Formulario de contacto</h2>

      <div role="status" class="mb-6 hidden rounded border-l-4 border-green-700 bg-green-50 p-4 text-green-900" data-aviso="enviado">
        Mensaje enviado. Te responderemos a la brevedad.
      </div>
      <div role="alert" class="mb-6 hidden rounded border-l-4 border-py-rojo bg-red-50 p-4 text-py-rojo-oscuro" data-aviso="error">
        No se pudo enviar el mensaje. Revisá los datos o escribinos directamente a <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.
      </div>

      <div role="alert" class="mb-6 hidden rounded border-l-4 border-py-rojo bg-red-50 p-4 text-py-rojo-oscuro" data-aviso="limite">
        Recibimos varios mensajes seguidos desde tu conexión. Probá de nuevo en una hora o escribinos a
        <a href={`mailto:${contacto.email}`}>{contacto.email}</a>.
      </div>

      <form method="post" action={accionFormulario} class="space-y-5" data-formulario>
        <div>
          <label for="nombre" class={etiquetaCampo}>Nombre completo <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <input id="nombre" name="nombre" type="text" required autocomplete="name" maxlength="120" placeholder="Tu nombre" class={campo} />
        </div>

        <div>
          <label for="email" class={etiquetaCampo}>Email <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" maxlength="160" placeholder="tu@email.com" class={campo} />
        </div>

        <div>
          <label for="mensaje" class={etiquetaCampo}>Mensaje <span class="text-py-rojo" aria-hidden="true">*</span></label>
          <textarea id="mensaje" name="mensaje" required rows="5" maxlength="5000" placeholder="¿En qué podemos ayudarte?" class={campo}></textarea>
        </div>

        <!-- Anti-spam: trampa invisible, tiempo mínimo y (opcional) Turnstile -->
        <CamposProteccion />

        <p class="text-xs text-gray-500"><span class="text-py-rojo" aria-hidden="true">*</span> Campos obligatorios</p>
        <p class="text-xs text-gray-500">
          Usamos tus datos solo para responderte. Más información en la{" "}
          <a href={conBase('/privacidad/')}>política de privacidad</a>.
        </p>

        <button type="submit" class="font-serif flex min-h-12 w-full items-center justify-center gap-2 rounded bg-py-azul px-6 font-semibold text-white hover:bg-py-azul-oscuro sm:w-auto" data-boton-enviar>
          Enviar mensaje
          <Icon name="lucide:send" class="h-4 w-4" aria-hidden="true" />
        </button>
      </form>
    </section>
  </div>
</LayoutBase>

<script>
  // ?enviado=1 / ?error=1 / ?limite=1 los agrega enviar.php al volver
  const params = new URLSearchParams(location.search);
  for (const aviso of ['enviado', 'error', 'limite']) {
    if (params.get(aviso) === '1') document.querySelector(`[data-aviso="${aviso}"]`)?.classList.remove('hidden');
  }
</script>
