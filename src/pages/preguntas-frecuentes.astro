---
import LayoutBase from '../layouts/LayoutBase.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { conBase } from '../lib/rutas';
import { getPreguntas } from '../data/glosario';

const preguntasFrecuentes = await getPreguntas();

const descripcion =
  '¿Paraguay se quedará sin energía? ¿Cuándo? ¿Qué es el HVDC de ITAIPU? Respuestas claras sobre el sector ' +
  'eléctrico paraguayo, basadas en los informes técnicos del IPPSE.';

// FAQPage: habilita los resultados enriquecidos de preguntas en buscadores.
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: preguntasFrecuentes.map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.texto },
    })),
  },
];
---

<LayoutBase titulo="Preguntas frecuentes" descripcion={descripcion} schema={schema} claves={['crisis energética Paraguay', 'déficit de energía', 'HVDC ITAIPU']}>
  <EncabezadoPagina
    titulo="Preguntas frecuentes"
    bajada="Lo que más se pregunta sobre el futuro energético del Paraguay, respondido a partir de nuestros informes."
  />

  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <div class="space-y-4">
      {preguntasFrecuentes.map((p) => (
        <details id={p.id} class="group scroll-mt-6 rounded border border-gray-200 border-l-4 border-l-py-azul bg-white shadow-sm open:border-l-py-rojo">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 [&::-webkit-details-marker]:hidden">
            <h2 class="font-serif text-lg font-semibold leading-snug text-gray-900">{p.pregunta}</h2>
            <span class="shrink-0 text-py-rojo transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
          </summary>
          <div class="border-t border-gray-100 px-5 pb-5 pt-3 leading-relaxed text-gray-700">
            <div class="space-y-3 [&_a]:font-semibold [&_a]:text-py-azul [&_ul]:mt-2 [&_ul]:flex [&_ul]:flex-wrap [&_ul]:gap-x-5 [&_ul]:gap-y-1 [&_ul]:text-sm" set:html={p.html} />
          </div>
        </details>
      ))}
    </div>

    <p class="mt-10 text-sm text-gray-600">
      ¿No encontrás un término? Consultá el <a href={conBase('/glosario/')}>glosario técnico</a> o{" "}
      <a href={conBase('/contacto/#formulario')}>escribinos</a>.
    </p>
  </div>

  <script>
    // Si se llega con un ancla (/preguntas-frecuentes/#hvdc-itaipu), se abre esa pregunta.
    const abrir = () => {
      const destino = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (destino instanceof HTMLDetailsElement) destino.open = true;
    };
    abrir();
    window.addEventListener('hashchange', abrir);
  </script>
</LayoutBase>
