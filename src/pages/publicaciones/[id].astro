---
// Página de cada publicación: el informe completo como HTML generado en el build
// (indexable por buscadores y asistentes de IA, con vista previa al compartir).
// Fórmulas con KaTeX en el build; los diagramas Mermaid se dibujan en el navegador.
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import LayoutBase from '../../layouts/LayoutBase.astro';
import CopiarCita from '../../components/CopiarCita.astro';
import CoberturaMedios from '../../components/CoberturaMedios.astro';
import { conBase } from '../../lib/rutas';
import { resolverRutasRepo } from '../../lib/rutas-repo';
import {
  categorias, citaPublicacion, fechaLegible, getPublicaciones, urlFuenteDocumento, type Publicacion,
} from '../../data/publicaciones';
import { getCoberturaPorInforme } from '../../data/prensa';
import { carpetaPublicaciones } from '../../data/fuenteDocumentos';

export async function getStaticPaths() {
  const publicaciones = await getPublicaciones();
  const entradas = await getCollection('publicaciones');
  // Solo las publicadas: las "próximamente" no tienen página.
  return publicaciones
    .filter((p) => p.disponible)
    .map((publicacion) => ({
      params: { id: publicacion.id },
      props: { publicacion, entrada: entradas.find((e) => e.id === publicacion.id)! },
    }));
}

interface Props {
  publicacion: Publicacion;
  entrada: Awaited<ReturnType<typeof getCollection<'publicaciones'>>>[number];
}

const { publicacion: p, entrada } = Astro.props;
const html = resolverRutasRepo(entrada.rendered?.html ?? '', carpetaPublicaciones);
const indice = (entrada.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const tieneDiagramas = html.includes('class="mermaid"');
const cita = citaPublicacion(p, Astro.site!);
const notas = (await getCoberturaPorInforme()).get(p.id) ?? [];

// schema.org: informe técnico con autor institucional, fecha y PDF.
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const raiz = new URL(import.meta.env.BASE_URL, Astro.site).href;
const schema = [
  {
    '@type': 'Report',
    '@id': `${urlPagina}#informe`,
    name: p.titulo,
    headline: p.titulo,
    abstract: p.extracto,
    datePublished: p.fecha,
    inLanguage: 'es-PY',
    author: { '@type': 'Organization', name: `${p.autor} — IPPSE` },
    publisher: { '@id': `${raiz}#organizacion` },
    mainEntityOfPage: { '@id': `${urlPagina}#pagina` },
    ...(p.etiquetas.length > 0 && { keywords: p.etiquetas.join(', ') }),
    ...(p.pdf && { encoding: { '@type': 'MediaObject', contentUrl: p.pdf, encodingFormat: 'application/pdf' } }),
  },
];
---

<LayoutBase
  titulo={p.titulo}
  descripcion={p.extracto}
  tipo="article"
  publicado={p.fecha.length === 7 ? `${p.fecha}-01` : p.fecha}
  migas={[{ nombre: 'Informes y Publicaciones', ruta: conBase('/publicaciones/') }]}
  schema={schema}
  claves={p.etiquetas}
  imagenOg={conBase(`/og/publicaciones/${p.id}.png`)}
>
  <!-- Encabezado del documento -->
  <div class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-10 lg:px-8">
      <nav aria-label="Migas de pan" class="text-sm text-gray-500 print:hidden">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={conBase('/')}>Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={conBase('/publicaciones/')}>Informes y Publicaciones</a></li>
        </ol>
      </nav>
      <p class="font-serif mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm font-semibold">
        <span class="text-py-rojo">{categorias[p.categoria]}</span>
        <time datetime={p.fecha} class="text-gray-500">{fechaLegible(p.fecha)}</time>
        {p.lectura > 0 && <span class="font-normal text-gray-500">{p.lectura} min de lectura</span>}
      </p>
      <h1 class="mt-3 border-l-4 border-py-rojo pl-4 text-2xl font-bold leading-tight break-words sm:text-3xl md:text-4xl">
        {p.titulo}
      </h1>
      <p class="mt-3 pl-5 text-gray-600">{p.autor}</p>

      <div class="mt-6 flex flex-wrap gap-3 print:hidden">
        {p.pdf && (
          <a href={p.pdf} target="_blank" rel="noopener" class="font-serif inline-flex min-h-11 items-center gap-2 rounded bg-py-rojo px-4 text-sm font-semibold text-white no-underline hover:bg-py-rojo-oscuro">
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
            Ver PDF oficial
            <span class="sr-only">(abre en una pestaña nueva)</span>
          </a>
        )}
        <button type="button" class="font-serif inline-flex min-h-11 items-center gap-2 rounded border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:border-py-azul hover:text-py-azul" data-imprimir>
          <Icon name="lucide:printer" class="h-4 w-4" aria-hidden="true" />
          Imprimir / PDF
        </button>
        <a href={urlFuenteDocumento(p.id)} target="_blank" rel="noopener" class="font-serif inline-flex min-h-11 items-center gap-2 rounded border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 no-underline hover:border-py-azul hover:text-py-azul">
          Ver fuente en GitHub
          <span class="sr-only">(abre en una pestaña nueva)</span>
        </a>
      </div>

      <figure class="mt-6 max-w-3xl rounded border border-gray-200 border-l-4 border-l-py-azul bg-gray-50 p-4 print:hidden">
        <figcaption class="font-serif text-sm font-semibold text-gray-700">Citá así</figcaption>
        <p class="mt-2 text-sm leading-relaxed break-words text-gray-800">{cita}</p>
        <CopiarCita cita={cita} class="mt-3 min-h-11 rounded border border-gray-300 bg-white px-4 text-sm text-gray-700 hover:border-py-azul hover:text-py-azul" />
      </figure>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <div class:list={['grid grid-cols-1 gap-10', indice.length >= 2 && 'lg:grid-cols-[16rem_minmax(0,1fr)]']}>
      {indice.length >= 2 && (
        <aside class="print:hidden lg:sticky lg:top-6 lg:max-h-[calc(100dvh-3rem)] lg:self-start lg:overflow-y-auto">
          <details class="group rounded border border-gray-200 bg-white lg:border-0 lg:bg-transparent" open data-indice-details>
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between px-4 font-serif font-semibold text-gray-900 lg:pointer-events-none lg:min-h-0 lg:px-0 lg:text-base lg:text-gray-700 [&::-webkit-details-marker]:hidden">
              Índice del documento
              <span class="text-py-rojo transition-transform group-open:rotate-180 lg:hidden" aria-hidden="true">▾</span>
            </summary>
            <nav aria-label="Índice del documento" class="border-t border-gray-200 px-2 py-2 lg:border-0 lg:px-0">
              <ol class="space-y-0.5 border-l border-gray-200 text-sm">
                {indice.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class:list={[
                      '-ml-px flex min-h-10 items-center border-l-2 border-transparent py-1 pr-2 text-gray-700 no-underline hover:border-py-rojo hover:text-py-azul lg:min-h-0',
                      h.depth === 3 ? 'pl-7 text-[0.8125rem]' : 'pl-4 font-semibold',
                    ]}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      )}

      <article
        class="documento prose prose-gray max-w-none min-w-0 break-words rounded border border-gray-200 bg-white px-4 py-6 shadow-sm sm:p-10
               prose-headings:font-serif prose-headings:scroll-mt-6 prose-h2:mt-12 prose-h2:border-b-2 prose-h2:border-py-azul prose-h2:pb-2 prose-h2:text-2xl md:prose-h2:text-3xl
               prose-h2:first:mt-0 prose-h3:text-py-azul prose-a:text-py-azul prose-strong:text-gray-900
               prose-table:my-0 prose-th:bg-gray-100 prose-th:px-3 prose-th:py-2 prose-td:px-3 prose-td:py-2
               print:border-0 print:p-0 print:shadow-none"
        set:html={html}
      />
    </div>

    {notas.length > 0 && (
      <div class:list={['mt-12 max-w-3xl print:hidden', indice.length >= 2 && 'lg:ml-[18.5rem]']}>
        <CoberturaMedios notas={notas} />
      </div>
    )}
  </div>

  {tieneDiagramas && <span hidden data-con-diagramas></span>}
</LayoutBase>

<script>
  import { dibujarDiagramas } from '../../lib/mermaid-cliente';

  document.querySelector('[data-imprimir]')?.addEventListener('click', () => window.print());

  // En móvil el índice arranca cerrado (en escritorio está siempre visible).
  const indice = document.querySelector<HTMLDetailsElement>('[data-indice-details]');
  if (indice && !matchMedia('(min-width: 1024px)').matches) indice.open = false;

  // Mermaid pesa ~600 KB: se descarga recién cuando el primer diagrama se acerca a la
  // pantalla, así no compite con la carga inicial del informe.
  const primerDiagrama = document.querySelector('.documento .mermaid');
  if (document.querySelector('[data-con-diagramas]') && primerDiagrama) {
    const observador = new IntersectionObserver((entradas) => {
      if (!entradas.some((e) => e.isIntersecting)) return;
      observador.disconnect();
      void dibujarDiagramas(document.querySelector('.documento') ?? document);
    }, { rootMargin: '800px 0px' });
    observador.observe(primerDiagrama);
  }
</script>
