---
// Home en portugués: espejo de src/pages/index.astro. Textos del diccionario i18n.
import { conBase } from '../../lib/rutas';
import { Icon } from 'astro-icon/components';
import LayoutBase from '../../layouts/LayoutBase.astro';
import TarjetaPublicacion from '../../components/TarjetaPublicacion.astro';
import { diccionarios } from '../../data/i18n';
import { getPublicaciones, urlVisor, atributosPdf } from '../../data/publicaciones';
import { pdfInforme226 } from '../../data/documentos';

const d = diccionarios.pt;
const t = d.contenido.inicio;

const recientes = (await getPublicaciones()).slice(0, 3);
---

<LayoutBase lang="pt" esInicio titulo={t.titulo} descripcion={t.descripcion}>
  <!-- Hero -->
  <section aria-labelledby="hero-titulo" class="relative overflow-hidden border-b border-gray-200 bg-white">
    <div class="absolute inset-y-0 right-0 hidden w-1/2 lg:block" aria-hidden="true">
      <picture>
        <source
          media="(min-width: 1024px)"
          srcset={`${conBase('/assets/power-paraguay/lineas-transmision-800.webp')} 800w, ${conBase('/assets/power-paraguay/22a32298a_generated_43a648f3.webp')} 1200w`}
          sizes="50vw"
        />
        <img
          src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
          alt=""
          width="1200"
          height="800"
          class="h-full w-full object-cover"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-white via-white/60 to-transparent"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-2xl">
        <h1 id="hero-titulo" class="text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
          {t.nombreLargo}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-gray-700 sm:text-lg">{t.presentacion}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a href={t.enlacesRapidos[0]!.href} class="font-serif rounded bg-py-azul px-6 py-3 text-center font-semibold text-white no-underline hover:bg-py-azul-oscuro hover:text-white">
            {t.ctaInformes}
          </a>
          <a href={conBase('/pt/nosotros/')} class="font-serif rounded border-2 border-py-rojo px-6 py-3 text-center font-semibold text-py-rojo no-underline hover:bg-py-rojo hover:text-white">
            {t.ctaConocer}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Atalhos -->
  <section aria-label="Atalhos" class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 pt-5 pb-10 sm:px-6 md:pt-6 md:pb-12 lg:px-8">
      <ul class="grid grid-cols-1 divide-y divide-gray-200 border-y border-gray-200 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x lg:border-y-0">
        {t.enlacesRapidos.map(({ titulo, descripcion, href }) => (
          <li class="sm:[&:nth-child(n+3)]:border-t sm:[&:nth-child(n+3)]:border-gray-200 lg:[&:nth-child(n+3)]:border-t-0">
            <a href={href} class="group block py-4 no-underline lg:px-6 lg:py-1 lg:first:pl-0">
              <span class="block font-serif text-lg font-semibold text-gray-900 underline decoration-transparent underline-offset-4 group-hover:text-py-azul group-hover:decoration-py-rojo">{titulo}</span>
              <span class="mt-1 block text-sm text-gray-600">{descripcion}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Relatório destacado -->
  <section aria-labelledby="informe-titulo" class="border-t-4 border-t-py-rojo border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <div class="relative mb-8 overflow-hidden rounded-lg">
        <!-- Recortes a la medida de la banda: 1,9:1 en móvil y 4,7:1 desde 640 px -->
        <picture>
          <source
            media="(min-width: 640px)"
            srcset={conBase('/assets/power-paraguay/itaipu-banda-1024.webp')}
            width="1024"
            height="218"
          />
          <img
            src={conBase('/assets/power-paraguay/itaipu-banda-movil-640.webp')}
            srcset={`${conBase('/assets/power-paraguay/itaipu-banda-movil-640.webp')} 640w, ${conBase('/assets/power-paraguay/itaipu-banda-movil-768.webp')} 768w, ${conBase('/assets/power-paraguay/itaipu-banda-movil-1024.webp')} 1024w`}
            sizes="100vw"
            alt={t.informe.altImagen}
            width="640"
            height="344"
            class="h-48 w-full object-cover sm:h-64"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        <p class="absolute bottom-4 left-4 font-serif text-lg font-semibold text-white sm:text-xl">
          {t.informe.titulo}
        </p>
      </div>

      <div class="flex w-full flex-col gap-5 rounded bg-py-rojo p-5 sm:p-6 md:flex-row md:items-center md:justify-between">
        <div class="flex items-start gap-4">
          <Icon name="lucide:triangle-alert" class="h-8 w-8 shrink-0 text-white sm:h-10 sm:w-10" aria-hidden="true" />
          <div>
            <p class="font-serif text-3xl font-bold leading-none text-white sm:text-4xl">{t.informe.franja}</p>
            <p class="mt-2 text-sm leading-relaxed text-white sm:text-base">
              <strong class="font-semibold">{t.informe.franjaTexto.split(':').at(0)}:</strong> {t.informe.franjaTexto.split(':').slice(1).join(':').trim()}
            </p>
          </div>
        </div>
        <a
          href={urlVisor('informe-2-26')}
          class="font-serif inline-flex min-h-11 shrink-0 items-center justify-center rounded bg-white px-6 py-3 font-semibold text-py-rojo no-underline hover:bg-py-azul-claro hover:text-py-azul-oscuro"
        >
          {t.informe.franjaCta}
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-10 md:mt-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-14">
        <div>
          <h2 id="informe-titulo" class="text-2xl font-bold leading-tight sm:text-3xl">
            {t.informe.titulo}
          </h2>
          <p class="mt-4 leading-relaxed text-gray-700">{t.informe.bajada}</p>
          <p class="mt-6 font-serif text-lg font-semibold text-py-azul">{t.informe.labelDesafios}</p>
          <ol class="mt-3 divide-y divide-gray-200 border-y border-gray-200">
            {t.informe.desafios.map((texto, i) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] py-3">
                <span class="font-serif text-lg font-semibold leading-snug text-py-rojo" aria-hidden="true">{String.fromCharCode(97 + i)})</span>
                <span class="leading-relaxed text-gray-800">{texto}</span>
              </li>
            ))}
          </ol>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              href={urlVisor('informe-2-26')}
              class="font-serif inline-flex min-h-11 items-center gap-2 rounded bg-py-azul px-6 py-3 font-semibold text-white no-underline hover:bg-py-azul-oscuro"
            >
              {t.informe.ctaLeer}
            </a>
            <a
              href={pdfInforme226.href}
              {...atributosPdf}
              class="font-serif inline-flex min-h-11 items-center gap-2 rounded border border-py-rojo px-6 py-3 font-semibold text-py-rojo no-underline hover:bg-py-rojo hover:text-white"
            >
              <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
              {t.informe.ctaPdf}
              <span class="sr-only">{t.informe.srPdf}</span>
            </a>
          </div>
        </div>

        <div>
          <div class="border-t-2 border-gray-900 pt-4">
            <h3 class="font-serif text-lg font-semibold">{t.informe.tabla.titulo}</h3>
            <div class="mt-4 overflow-x-auto" tabindex="0" role="region" aria-label={t.informe.tabla.titulo}>
            <table class="w-full text-left text-sm">
              <caption class="sr-only">{t.informe.tabla.caption}</caption>
              <thead>
                <tr class="font-serif border-b border-gray-300 text-sm font-semibold text-gray-500">
                  <th scope="col" class="py-2 pr-3">{t.informe.tabla.fuente}</th>
                  <th scope="col" class="py-2 pr-3 whitespace-nowrap">{t.informe.tabla.plazo}</th>
                  <th scope="col" class="py-2">{t.informe.tabla.horizonte}</th>
                </tr>
              </thead>
              <tbody>
                {t.informe.tabla.filas.map(({ fuente, plazo, horizonte, firme }) => (
                  <tr class="border-b border-gray-200 last:border-0">
                    <th scope="row" class="py-2 pr-3 font-semibold text-gray-900">{fuente}</th>
                    <td class="py-2 pr-3 whitespace-nowrap text-gray-700">{plazo}</td>
                    <td class="py-2 text-gray-600">
                      {horizonte}
                      {firme && <span class="ml-1 font-semibold text-py-azul">→ {t.informe.tabla.firme}</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </div>

          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-gray-200 pt-5">
            {t.informe.cifras.map(({ valor, etiqueta }) => (
              <div>
                <dt class="font-serif text-xl font-bold text-py-azul sm:text-2xl">{valor}</dt>
                <dd class="mt-1 text-sm leading-snug text-gray-600">{etiqueta}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- Mudança de paradigma -->
      <div class="mt-10 border-t border-gray-200 pt-8 md:mt-12">
        <p class="font-serif text-lg font-semibold text-py-azul">{t.informe.paradigma.titulo}</p>
        <p class="mt-3 max-w-3xl leading-relaxed text-gray-700">{t.informe.paradigma.texto}</p>
        <dl class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-10">
          <div>
            <dt class="font-serif text-sm font-semibold text-gray-500">{t.informe.paradigma.antesLabel}</dt>
            <dd class="mt-1 font-serif text-lg font-semibold text-gray-500 line-through decoration-gray-400 decoration-1 sm:text-xl">
              {t.informe.paradigma.antes}
            </dd>
          </div>
          <div class="sm:border-l sm:border-gray-200 sm:pl-10">
            <dt class="font-serif text-sm font-semibold text-py-rojo">{t.informe.paradigma.ahoraLabel}</dt>
            <dd class="mt-2 font-serif text-lg font-semibold text-gray-900 sm:text-xl">
              {t.informe.paradigma.ahora}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Publicações recentes -->
  <section aria-labelledby="recientes-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-serif text-sm font-semibold text-py-rojo">{t.recientes.sobretitulo}</p>
        <h2 id="recientes-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">{t.recientes.titulo}</h2>
      </div>
      <a href={t.enlacesRapidos[0]!.href} class="inline-flex min-h-11 items-center font-semibold">{t.recientes.cta} →</a>
    </div>
    <p class="mt-2 text-sm text-gray-500">{t.recientes.nota}</p>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-3">
      {recientes.map((publicacion) => <li><TarjetaPublicacion publicacion={publicacion} /></li>)}
    </ul>
  </section>

  <!-- Quem somos -->
  <section aria-labelledby="nosotros-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div class="relative overflow-hidden rounded-lg">
        <img
          src={conBase('/assets/power-paraguay/sala-control-800.webp')}
          srcset={`${conBase('/assets/power-paraguay/sala-control-640.webp')} 640w, ${conBase('/assets/power-paraguay/sala-control-800.webp')} 800w, ${conBase('/assets/power-paraguay/390840802_generated_d56ac8c6.webp')} 1200w`}
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="Sala de controle elétrico"
          width="1200"
          height="800"
          class="h-64 w-full object-cover sm:h-80"
          loading="lazy"
        />
      </div>
      <div class="flex flex-col">
        <p class="font-serif text-sm font-semibold text-py-rojo">{t.nosotros.sobretitulo}</p>
        <h2 id="nosotros-titulo" class="mt-3 text-2xl font-bold leading-tight sm:text-3xl">{t.nosotros.titulo}</h2>
        <p class="mt-4 leading-relaxed text-gray-700">{t.nosotros.parrafo}</p>
        <a href={conBase('/pt/nosotros/')} class="mt-4 inline-flex min-h-11 items-center font-semibold">{t.nosotros.cta} →</a>
      </div>
    </div>
    <dl class="mt-12 grid grid-cols-1 gap-8 border-t-2 border-gray-900 pt-6 md:grid-cols-3 md:gap-10">
      <div>
        <dt class="font-serif text-lg font-semibold text-gray-900">{t.mision.titulo}</dt>
        <dd class="mt-2 leading-relaxed text-gray-700">{t.mision.texto}</dd>
      </div>
      <div>
        <dt class="font-serif text-lg font-semibold text-gray-900">{t.vision.titulo}</dt>
        <dd class="mt-2 leading-relaxed text-gray-700">{t.vision.texto}</dd>
      </div>
      <div>
        <dt class="font-serif text-lg font-semibold text-gray-900">{t.valores.titulo}</dt>
        <dd class="mt-2">
          <ul class="space-y-3">
            {t.valores.items.map(({ titulo, descripcion }) => (
              <li class="leading-relaxed text-gray-700">
                <strong class="font-semibold text-gray-900">{titulo}.</strong> {descripcion}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <!-- Eixos estratégicos -->
  <section aria-labelledby="ejes-titulo" class="border-y border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <p class="font-serif text-sm font-semibold text-py-rojo">{t.ejes.sobretitulo}</p>
      <h2 id="ejes-titulo" class="mt-3 text-2xl font-bold sm:text-3xl">{t.ejes.titulo}</h2>
      <ul class="mt-8 grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 md:mt-10 lg:grid-cols-4">
        {t.ejes.items.map(({ titulo, descripcion, icono }) => (
          <li class="border-t border-gray-300 pt-5">
            <Icon name={icono} class="h-7 w-7 text-py-rojo" aria-hidden="true" />
            <h3 class="mt-3 text-lg font-semibold leading-snug">{titulo}</h3>
            <p class="mt-2 leading-relaxed text-gray-600">{descripcion}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

</LayoutBase>
