---
// "Quem somos" en portugués: espejo de src/pages/nosotros.astro (textos i18n).
import { conBase } from '../../lib/rutas';
import { Icon } from 'astro-icon/components';
import LayoutBase from '../../layouts/LayoutBase.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import { diccionarios } from '../../data/i18n';

const d = diccionarios.pt;
const t = d.contenido.nosotros;
const inicio = { etiqueta: d.ui.inicio, href: conBase('/pt/') };
---

<LayoutBase lang="pt" titulo={t.titulo} descripcion={t.descripcion}>
  <EncabezadoPagina titulo={t.titulo} bajada={t.descripcion} inicioEtiqueta={inicio.etiqueta} inicioHref={inicio.href} />

  <!-- História -->
  <section aria-labelledby="historia-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
      <div>
        <h2 id="historia-titulo" class="text-2xl font-bold leading-tight sm:text-3xl">{t.historia.titulo}</h2>
        {t.historia.parrafos.map((p) => <p class="mt-4 max-w-3xl leading-relaxed text-gray-700">{p}</p>)}
      </div>
      <aside class="self-start border-t-2 border-gray-900 pt-4 lg:mt-2" aria-label="Dados de fundação">
        <p class="font-serif text-sm font-semibold text-gray-500">{t.fundado}</p>
        <p class="mt-1 font-serif text-3xl font-bold leading-tight text-gray-900">23 de abril de 1993</p>
        <p class="mt-2 text-sm text-gray-600">{t.fundadoLugar}</p>
        <a href={conBase('/institucional/#acta-de-constitución')} class="mt-2 flex min-h-11 items-center text-sm font-semibold">{t.verActa}</a>
      </aside>
    </div>
  </section>

  <!-- Missão e visão -->
  <section aria-labelledby="mision-titulo" class="border-y border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <h2 id="mision-titulo" class="text-2xl font-bold sm:text-3xl">{t.nombres.misionTitulo}</h2>
      <dl class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-0 md:divide-x md:divide-gray-200">
        <div class="md:pr-10">
          <dt class="font-serif text-xl font-semibold text-gray-900">{t.misionVision.mision}</dt>
          <dd class="mt-2 text-lg leading-relaxed text-gray-700">{t.misionVision.misionTexto}</dd>
        </div>
        <div class="md:pl-10">
          <dt class="font-serif text-xl font-semibold text-gray-900">{t.misionVision.vision}</dt>
          <dd class="mt-2 text-lg leading-relaxed text-gray-700">{t.misionVision.visionTexto}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Valores -->
  <section aria-labelledby="valores-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <h2 id="valores-titulo" class="text-2xl font-bold sm:text-3xl">{t.nombres.valoresTitulo}</h2>
    <ul class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
      {t.valoresItems.map(({ titulo, descripcion }) => (
        <li class="border-t-2 border-py-rojo pt-4">
          <h3 class="text-lg font-semibold">{titulo}</h3>
          <p class="mt-2 leading-relaxed text-gray-600">{descripcion}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Equipe -->
  <section aria-labelledby="equipo-titulo" class="border-y border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <h2 id="equipo-titulo" class="text-2xl font-bold sm:text-3xl">{t.nombres.equipoTitulo}</h2>
      <ul class="mt-8 divide-y divide-gray-200 border-y border-gray-200">
        {t.equipo.map(({ nombre, rol, bio }) => (
          <li class="grid grid-cols-1 gap-1 py-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] md:gap-10">
            <div>
              <h3 class="text-lg font-semibold">{nombre}</h3>
              <p class="mt-1 text-sm font-semibold text-py-azul">{rol}</p>
            </div>
            <p class="leading-relaxed text-gray-600">{bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Marco institucional -->
  <section aria-labelledby="marco-titulo" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="marco-titulo" class="text-2xl font-bold sm:text-3xl">{t.nombres.marcoTitulo}</h2>
      <a href={conBase('/institucional/#descargas')} class="inline-flex min-h-11 items-center gap-2 font-semibold">
        <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
        {t.nombres.ctaDescargas}
      </a>
    </div>
    <p class="mt-4 text-sm text-gray-500">{t.notaDocumentos}</p>
    <ul class="mt-4 grid grid-cols-1 gap-2 border-t border-gray-200 pt-4">
      {[
        { titulo: 'Constituição — Carta constitutiva', href: conBase('/institucional/#constitución') },
        { titulo: 'Estatutos', href: conBase('/institucional/#estatutos') },
        { titulo: 'Código de Ética', href: conBase('/institucional/#código-de-ética') },
        { titulo: 'Regulamento e demais documentos', href: conBase('/institucional/') },
      ].map(({ titulo, href }) => (
        <li class="border-b border-gray-200">
          <a href={href} class="group flex min-h-14 items-center justify-between gap-4 py-3 font-serif text-lg font-semibold text-gray-900 no-underline hover:text-py-azul">
            {titulo}
            <Icon name="lucide:chevron-right" class="h-5 w-5 shrink-0 text-gray-400 group-hover:text-py-rojo" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</LayoutBase>
