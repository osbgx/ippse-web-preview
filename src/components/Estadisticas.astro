---
// Estadísticas de visitas con Umami (sin cookies ni datos personales).
// Placeholder: no se carga nada hasta definir las dos variables de entorno:
//   PUBLIC_UMAMI_SRC -> URL del script, p. ej. https://cloud.umami.is/script.js
//                       (o la de un Umami propio, p. ej. https://estadisticas.ippse.org.py/script.js)
//   PUBLIC_UMAMI_ID  -> "Website ID" que da Umami al registrar el sitio
// Solo cuenta visitas en el dominio de producción (data-domains), no en pruebas.
const src = (import.meta.env.PUBLIC_UMAMI_SRC ?? '').trim();
const id = (import.meta.env.PUBLIC_UMAMI_ID ?? '').trim();
const dominio = Astro.site?.hostname ?? '';
---

{src && id && (
  <script is:inline defer src={src} data-website-id={id} data-domains={dominio} data-do-not-track="true"></script>
)}
