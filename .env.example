# Datos de contacto del IPPSE.
#
# Copiá este archivo a ".env" y completá los valores reales. El archivo ".env"
# NO se sube al repositorio (está en .gitignore), así que podés cambiarlo sin
# afectar a nadie más. Si una variable queda vacía, se usa el valor por defecto
# definido en src/data/contacto.ts.
#
# El prefijo PUBLIC_ es necesario para que el valor también esté disponible en
# el navegador; sirve igual para el servidor durante el build.

# Correo institucional (se muestra y se usa en los enlaces mailto: y schema.org).
PUBLIC_IPPSE_EMAIL=contacto@ippse.org.py

# Teléfono tal como querés que se vea en pantalla. El enlace tel: se limpia solo.
PUBLIC_IPPSE_TELEFONO=+595 984 143 700

# Ciudad / sede.
PUBLIC_IPPSE_CIUDAD=Asunción, Paraguay

# URL completa del canal de WhatsApp (canal de difusión del IPPSE).
PUBLIC_IPPSE_WHATSAPP=https://whatsapp.com/channel/000000000000000

# Contacto directo de prensa (kit de prensa). Si queda vacío, se usan el correo y
# el teléfono generales.
PUBLIC_IPPSE_EMAIL_PRENSA=
PUBLIC_IPPSE_TELEFONO_PRENSA=

# Dirección física (calle y número). Si queda vacía, no se muestra.
PUBLIC_IPPSE_DIRECCION=

# Redes sociales: URL completa de cada perfil. Las que queden vacías no se muestran.
PUBLIC_IPPSE_FACEBOOK=
PUBLIC_IPPSE_INSTAGRAM=
PUBLIC_IPPSE_LINKEDIN=
PUBLIC_IPPSE_X=
PUBLIC_IPPSE_YOUTUBE=

# -----------------------------------------------------------------------------
# Repositorio de contenido (informes y publicaciones)
# -----------------------------------------------------------------------------
# De dónde se leen los informes de /publicaciones/ y del visor. Formato
# "usuario/repositorio", SIN https://github.com/. Se leen por HTTP en tiempo de
# build: no hace falta clonar nada.
#
# Cuando el contenido pase al repositorio real del cliente, cambiá esta línea:
# es el único cambio necesario para que el sitio apunte al nuevo repositorio.
PUBLIC_DOCS_REPO=osbgx/ippse-documentos

# Rama del repositorio desde la que se lee.
PUBLIC_DOCS_RAMA=main
#
# Nota: en cada build el sitio fija el SHA del último commit de esa rama y usa
# URLs con ese SHA (inmutables) para leer los archivos. Así la CDN de GitHub
# nunca sirve una versión vieja de un informe recién subido. No hay que
# configurar nada: es automático. Si el commit no se puede consultar, se cae al
# nombre de la rama.

# Token opcional de GitHub. Solo hace falta si el repositorio de contenido es
# privado o si el build supera el límite de peticiones anónimas de la API.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# MODO LOCAL (temporal, para desarrollo)
# -----------------------------------------------------------------------------
# Con PUBLIC_DOCS_LOCAL=1 el sitio lee los informes de la carpeta
# "contenido-local/" del propio proyecto (estructura: contenido/publicaciones/,
# documentos/, imagenes/), en vez del repositorio de GitHub. Sirve para ver los
# cambios sin commitear ni esperar al build remoto.
#
#   PUBLIC_DOCS_LOCAL=1 npm run build     (y luego servir dist/)
#
# Para volver a GitHub, BORRÁ esta variable (o ponela en 0): no hay que cambiar
# nada más. Al construir sin modo local, la carpeta se sincroniza pero no se usa.
# La copia servida (public/contenido-local/) está en .gitignore.
#
# PUBLIC_DOCS_LOCAL=1

# -----------------------------------------------------------------------------
# Estadísticas (Umami) — opcional. Sin estas dos variables no se carga nada.
# -----------------------------------------------------------------------------
# URL del script de Umami (Umami Cloud o una instalación propia).
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# "Website ID" que asigna Umami al registrar el sitio.
# PUBLIC_UMAMI_ID=

# -----------------------------------------------------------------------------
# Anti-spam de formularios (Cloudflare Turnstile) — opcional.
# -----------------------------------------------------------------------------
# Clave pública (site key). La secreta va en ippse-config/turnstile.php en cPanel.
# PUBLIC_TURNSTILE_SITEKEY=
